# ia-service/.env.example  (cópialo a .env; .env NUNCA se sube)

# Claves que acepta el header X-API-Key, separadas por comas (permite rotarlas sin cortar el servicio).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_API_KEYS=cambia-esta-clave

# siglip = modelo real (descarga y verifica best.pt) | falso = respuestas fijas, sin torch ni pesos
IA_MODELO=falso

# Pesos publicados (T-209). El servicio los descarga a IA_MODELO_DIR y verifica el SHA-256 antes de cargarlos.
IA_MODELO_URL=
IA_MODELO_SHA256=
IA_MODELO_DIR=/modelos

# auto | cpu | cuda
IA_DISPOSITIVO=auto

# Página de prueba en http://localhost:8100/demo (pon false en producción)
IA_DEMO=true

LOG_LEVEL=INFO
